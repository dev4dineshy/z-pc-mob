# Web and iOS simulator on the same computer:
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
EXPO_PUBLIC_ENCRYPTION_KEY=replace-with-the-same-64-character-hex-key-as-the-api

# Android emulator normally uses:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# A physical phone must use the computer's LAN address, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api/v1
